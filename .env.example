# Copy to .env. Consumed by systemd EnvironmentFile= (prod) and by
# python-dotenv at startup (dev). NEVER shell-sourced: the JSON value below
# does not survive `export $(cat .env | xargs)`.

PORT=8077
PDF_SIDECAR_WORKERS=4

# JSON array of ABSOLUTE paths. Every path-valued request field is resolved and
# containment-checked against these roots; anything outside is 403.
# A missing or malformed value yields an EMPTY allowlist plus one ERROR line —
# the service still starts, and every request 403s until it is fixed.
# Prod value:
PDF_SIDECAR_ALLOWED_ROOTS='["/opt/MaritimeQuery/data/docs","/opt/MaritimeQuery/data/cache","/opt/MaritimeQuery/data/sidecar_tmp"]'
